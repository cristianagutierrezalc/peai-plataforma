# Normalizacion de finales de linea entre Windows (dev) y Linux (Render/Docker)
* text=auto eol=lf

# Archivos que SIEMPRE deben ser LF (scripts)
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Archivos que SIEMPRE deben ser CRLF (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios: nunca tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.zip binary

# No normalizar lockfiles generados
package-lock.json -diff linguist-generated=true