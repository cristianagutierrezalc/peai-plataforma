# .env.example del backend - Desarrollo local
# Copia a .env y ajusta segun tu caso

ENVIRONMENT=development
DEBUG=true

# SQLite para desarrollo. En produccion usa PostgreSQL (ver ../.env.example)
DATABASE_URL=sqlite:///./peai.db

SECRET_KEY=cambiar-por-una-clave-segura-de-32-caracteres-minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Administrador inicial. Opcional en desarrollo: si lo dejas vacio,
# se puede crear el primer usuario directamente en la base de datos.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador
ADMIN_ROL=admin

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]