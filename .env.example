# .env.example - Variables de entorno para PEA-i Plataforma
# Copia este archivo a .env y completa los valores

# ==========================================
# BACKEND
# ==========================================

# Base de datos (Render PostgreSQL la provee automáticamente)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT - GENERA UNA CLAVE SEGURA: openssl rand -hex 32
SECRET_KEY=tu-clave-secreta-super-segura-de-32-caracteres-minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Dominios permitidos para el frontend
CORS_ORIGINS=["https://peai-frontend.onrender.com","http://localhost:3000"]

# Debug
DEBUG=false

# ==========================================
# FRONTEND
# ==========================================

# URL del backend API (para build de producción)
VITE_API_URL=https://peai-backend.onrender.com

# ==========================================
# OPCIONAL: SUPABASE (si migras auth)
# ==========================================

# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...