# .env.example - Variables de entorno para PEA-i Plataforma
# Copia este archivo a .env y completa los valores
# NUNCA subas el archivo .env real al repositorio

# ==========================================
# ENTORNO
# ==========================================
# development = permite SECRET_KEY de ejemplo
# production  = valida secretos al arrancar y se niega a iniciar si faltan
ENVIRONMENT=development
DEBUG=false

# ==========================================
# BASE DE DATOS
# ==========================================
# Desarrollo (SQLite local):
DATABASE_URL=sqlite:///./peai.db

# Produccion (Supabase o Render). Se acepta postgres:// y postgresql://,
# se normaliza automaticamente a postgresql+psycopg2://
# OJO: Render elimina su PostgreSQL gratis a los 30 dias.
# Supabase no. connection string en: Supabase > Project Settings > Database
# DATABASE_URL=postgresql://postgres.PROYECTO:PASSWORD@HOST:5432/postgres?sslmode=require

# Pool de conexiones (solo PostgreSQL). En serverless el proveedor corta
# conexiones ociosas, por eso pool_pre_ping esta siempre activo.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# ==========================================
# JWT
# ==========================================
# GENERA UNA CLAVE SEGURA: python generate-secret.py
# Minimo 32 caracteres. En produccion es obligatoria.
SECRET_KEY=tu-clave-secreta-super-segura-de-32-caracteres-minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# ADMINISTRADOR INICIAL
# ==========================================
# /api/auth/register esta CERRADO: solo un admin o coordinador autenticado
# puede crear cuentas. Estos valores son el unico punto de entrada inicial.
# El seeder es idempotente: si el usuario ya existe, no hace nada.
# En produccion son obligatorios; si faltan, la app no arranca.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-por-una-clave-segura
ADMIN_NOMBRE=Administrador
ADMIN_ROL=admin

# ==========================================
# CORS
# ==========================================
# Debe incluir EXACTAMENTE el dominio del frontend desplegado.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ==========================================
# FRONTEND (build de produccion)
# ==========================================
# OJO: Vite incrusta esto en el bundle en tiempo de build.
# Cambiarlo despues exige redesplegar el frontend.
VITE_API_URL=http://localhost:8000